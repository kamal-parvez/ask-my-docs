# Copy to .env and edit. All values are optional; defaults live in config.py.
CHATBOT_MODEL=qwen3.5:4b
OLLAMA_HOST=http://localhost:11434
CHATBOT_SYSTEM_PROMPT=You are a helpful, concise assistant. Keep answers short unless asked for detail.
CHATBOT_TEMPERATURE=0.7
CHATBOT_MAX_TURNS=10
CHATBOT_THINK=false
CHATBOT_CONVERSATIONS_DIR=./conversations
CHATBOT_EMBED_MODEL=nomic-embed-text
CHATBOT_CHUNK_SIZE=1200
CHATBOT_CHUNK_OVERLAP=120
CHATBOT_WEAVIATE_HOST=localhost
CHATBOT_WEAVIATE_PORT=8080
CHATBOT_WEAVIATE_GRPC_PORT=50051
CHATBOT_DOCUMENTS_DIR=./documents
CHATBOT_RAG_TOP_K=4
CHATBOT_RAG_MIN_SCORE=0.62
CHATBOT_NUM_CTX=8192
